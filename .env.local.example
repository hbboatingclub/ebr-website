# Sanity Project Config
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Only needed for write access / preview
SANITY_API_TOKEN=your-read-token

# Site URL
NEXT_PUBLIC_SITE_URL=https://electricboatrepair.com

# Service request form (Resend) — server-side only, never expose to the client
RESEND_API_KEY=
CONTACT_EMAIL=service@electricboatrepair.com
CONTACT_BCC_EMAIL=hbboatingclub@gmail.com
RESEND_FROM_EMAIL=EBR | Electric Boat Repair <service@electricboatrepair.com>
